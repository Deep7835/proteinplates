# Public site URL, used for canonical URLs, sitemap, and JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com

# Set to "true" to render reserved-height ad slots. Leave unset/false to hide them.
NEXT_PUBLIC_ADS_ENABLED=false

# Optional: Cloudflare Web Analytics token (cookie-free). Not needed if you use Cloudflare's "automatic setup".
# NEXT_PUBLIC_CF_BEACON_TOKEN=

# Optional: Umami Cloud (cookie-free analytics with UTM/campaign reports). Paste your website ID to turn it on.
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Only if you self-host Umami: your script URL (default https://cloud.umami.is/script.js).
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=

# Google Analytics 4 measurement ID (default is set in lib/config/site.ts). Set to an empty value to turn GA off.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
